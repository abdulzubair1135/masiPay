# ==========================================
# MasiCanteen Root Environment Variables
# ==========================================

# Backend API
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/masicanteen
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/masicanteen?retryWrites=true&w=majority

JWT_SECRET=super_secret_jwt_key_masicanteen_change_in_production_2026
JWT_EXPIRES_IN=7d

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000

# Cloudinary (For Profile and Menu Images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Default Canteen Settings
UPI_ID=canteen@upi
UPI_PAYEE_NAME=Masi Canteen Services

# Frontend Environment Variables (in apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
